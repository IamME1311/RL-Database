# Base path for the API. Leave as /api/v1 in dev so requests go through the Vite
# proxy (see vite.config.ts) and stay same-origin — required for the httpOnly
# session cookie to be sent.
VITE_API_BASE_URL=/api/v1

# Where the Vite dev proxy forwards /api. Change if the backend isn't on :8000.
VITE_PROXY_TARGET=http://localhost:8000

# Serve fixtures from src/lib/mocks instead of calling the backend.
# The search/auth/ingest endpoints this app needs do not exist in the backend yet
# (see PROPOSED_BACKEND_CHANGES.md), so this defaults to true for now.
VITE_USE_MOCKS=true
